{
  "name": "clniq360",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.11 <23"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && node scripts/check-raw-style-values.mjs && node scripts/check-cross-schema.mjs",
    "test": "vitest run",
    "test:rls": "vitest run --project rls",
    "contracts:gen": "pnpm --filter @clniq/contracts run gen",
    "db:up": "node scripts/dev-postgres.mjs up",
    "db:down": "node scripts/dev-postgres.mjs down",
    "new:module": "node scripts/new-module.mjs",
    "visual": "node scripts/visual-regression.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}

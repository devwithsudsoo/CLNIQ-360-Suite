{
  "name": "@clniq/kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared runtime for core and modules: tenant context, RLS, outbox, audit, idempotency, errors, paging, OTel, secrets, module server.",
  "exports": {
    ".": "./dist/index.js",
    "./sql/*": "./sql/*",
    "./testing": "./dist/testing.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@clniq/contracts": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}

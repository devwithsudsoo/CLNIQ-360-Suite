{
  "name": "@clniq/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLNIQ component library, styled only from @clniq/design-tokens (packaging Part A step 3, R9).",
  "exports": { ".": "./dist/index.js", "./styles.css": "./dist/styles.css" },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": { "@clniq/design-tokens": "workspace:*" },
  "peerDependencies": { "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": {
    "@storybook/react-vite": "^8.4.2",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.2",
    "vite": "^5.4.10"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clniq.com/events/envelope.json",
  "title": "CLNIQ event envelope (R8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "v", "tenant_id", "clinic_id", "practice_id", "actor", "correlation_id", "ts", "data"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
    "v": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": "string", "format": "uuid" },
    "clinic_id": { "type": ["string", "null"], "format": "uuid" },
    "practice_id": { "type": ["string", "null"], "format": "uuid" },
    "actor": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": { "kind": { "enum": ["user", "system", "integration"] }, "id": { "type": "string" } }
    },
    "correlation_id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" },
    "data": { "type": "object" }
  }
}
